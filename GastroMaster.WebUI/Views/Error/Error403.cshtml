@{
    ViewData["Title"] = "Erişim Engellendi";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<style>
    .error-page {
        background: var(--char);
        color: var(--paper);
        min-height: calc(100vh - 80px);
        display: flex;
        align-items: center;
        padding: 80px 0;
        text-align: center;
        overflow: hidden;
    }

        .error-page .container {
            width: 100%;
        }

    .error-icon {
        width: 110px;
        height: 110px;
        margin: 0 auto 26px;
        border-radius: 50%;
        background: var(--char-soft);
        color: var(--ketchup);
        display: grid;
        place-items: center;
        font-size: 48px;
    }

    .error-code {
        font-family: var(--display);
        font-weight: 900;
        font-size: clamp(120px, 22vw, 260px);
        line-height: .85;
        color: transparent;
        -webkit-text-stroke: 3px var(--ketchup);
    }

    .error-page h1 {
        font-family: var(--display);
        font-weight: 900;
        font-size: clamp(32px, 5vw, 56px);
        text-transform: uppercase;
        margin-top: 20px;
    }

    .error-page p {
        max-width: 48ch;
        margin: 16px auto 36px;
        color: rgba(250,250,247,.7);
    }

    .error-user {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        border-radius: 999px;
        background: var(--char-soft);
        color: var(--mustard);
        font-weight: 600;
        margin-bottom: 30px;
    }

    .error-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    .error-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 30px;
        border-radius: 999px;
        font-weight: 700;
        background: var(--ketchup);
        color: #fff;
        transition: background .2s;
    }

        .error-btn:hover {
            background: var(--ketchup-dark);
            color: #fff;
        }

    .error-btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 30px;
        border-radius: 999px;
        font-weight: 700;
        border: 1.5px solid rgba(250,250,247,.4);
        color: var(--paper);
        transition: all .2s;
    }

        .error-btn-outline:hover {
            border-color: var(--mustard);
            color: var(--mustard);
        }

    .error-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 60px;
        padding-top: 40px;
        border-top: 1px solid rgba(250,250,247,.12);
    }

        .error-links a {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 22px;
            border-radius: 14px;
            background: rgba(250,250,247,.06);
            color: var(--paper);
            font-weight: 600;
            transition: background .2s, color .2s;
        }

            .error-links a i {
                color: var(--ketchup);
            }

            .error-links a:hover {
                background: rgba(250,250,247,.12);
                color: var(--mustard);
            }

    .error-links-title {
        width: 100%;
        font-size: 13px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: rgba(250,250,247,.45);
        margin-bottom: 6px;
    }
</style>

<section class="error-page">
    <div class="container">
        <div class="error-icon"><i class="fa fa-ban"></i></div>
        <div class="error-code">403</div>
        <h1>Burası sadece personele</h1>
        <p>Giriş yaptın ama bu alana erişim yetkin yok. Bu bölüm sadece yöneticilere açık.</p>

        @if (User.Identity.IsAuthenticated)
        {
            <div class="error-user"><i class="fa fa-user-circle"></i> @User.Identity.Name olarak giriş yaptın</div>
        }

        <div class="error-actions">
            <a href="/" class="error-btn"><i class="fa fa-home"></i> Ana Sayfa</a>
            <a href="/Account/LogOut" class="error-btn-outline"><i class="fa fa-sign-out"></i> Farklı Hesapla Giriş Yap</a>
        </div>

        <div class="error-links">
            <div class="error-links-title">Senin için açık olanlar</div>
            <a href="/Default/Index"><i class="fa fa-cutlery"></i> Menü</a>
            <a href="/Baskets/Index"><i class="fa fa-shopping-basket"></i> Sepetim</a>
            <a href="/Default/Index"><i class="fa fa-calendar"></i> Rezervasyon</a>
            <a href="/Default/Index"><i class="fa fa-star"></i> Yorumlar</a>
        </div>
    </div>
</section>