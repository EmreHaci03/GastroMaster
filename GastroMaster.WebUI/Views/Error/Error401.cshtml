@{
    ViewData["Title"] = "Yetkisiz Erişim";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<style>
    .error-page {
        background: var(--char);
        color: var(--paper);
        padding: 100px 0 120px;
        text-align: center;
        overflow: hidden;
    }

    .error-icon {
        width: 110px;
        height: 110px;
        margin: 0 auto 26px;
        border-radius: 50%;
        background: var(--char-soft);
        color: var(--mustard);
        display: grid;
        place-items: center;
        font-size: 48px;
    }

    .error-code {
        font-family: var(--display);
        font-weight: 900;
        font-size: clamp(120px, 22vw, 260px);
        line-height: .85;
        color: transparent;
        -webkit-text-stroke: 3px var(--mustard);
    }

    .error-page h1 {
        font-family: var(--display);
        font-weight: 900;
        font-size: clamp(32px, 5vw, 56px);
        text-transform: uppercase;
        margin-top: 20px;
    }

    .error-page p {
        max-width: 46ch;
        margin: 16px auto 36px;
        color: rgba(250,250,247,.7);
    }

    .error-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    .error-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 30px;
        border-radius: 999px;
        font-weight: 700;
        background: var(--ketchup);
        color: #fff;
        transition: background .2s;
    }

        .error-btn:hover {
            background: var(--ketchup-dark);
            color: #fff;
        }

    .error-btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 30px;
        border-radius: 999px;
        font-weight: 700;
        border: 1.5px solid rgba(250,250,247,.4);
        color: var(--paper);
        transition: all .2s;
    }

        .error-btn-outline:hover {
            border-color: var(--mustard);
            color: var(--mustard);
        }
</style>

<section class="error-page">
    <div class="container">
        <div class="error-icon"><i class="fa fa-lock"></i></div>
        <div class="error-code">401</div>
        <h1>Mutfağa girişin yok</h1>
        <p>Bu sayfayı görüntülemek için yetkin bulunmuyor. Farklı bir hesapla giriş yapmayı deneyebilir ya da ana sayfaya dönebilirsin.</p>
        <div class="error-actions">
            <a href="/" class="error-btn"><i class="fa fa-home"></i> Ana Sayfa</a>
            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Account/LogOut" class="error-btn-outline"><i class="fa fa-sign-out"></i> Farklı Hesapla Giriş Yap</a>
            }
            else
            {
                <a href="/Account/Login" class="error-btn-outline"><i class="fa fa-sign-in"></i> Giriş Yap</a>
            }
        </div>
    </div>
</section>