@{
    ViewData["Title"] = "Canlı Destek";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<style>
    .chat-hero {
        background: var(--char);
        color: var(--paper);
        padding: 70px 0 80px;
    }

        .chat-hero .crumb {
            font-size: 14px;
            color: rgba(250,250,247,.6);
            margin-bottom: 14px;
        }

            .chat-hero .crumb a:hover {
                color: var(--mustard);
            }

        .chat-hero h1 {
            font-family: var(--display);
            font-weight: 900;
            font-size: clamp(48px, 7vw, 96px);
            line-height: .9;
            text-transform: uppercase;
        }

            .chat-hero h1 .stroke {
                color: transparent;
                -webkit-text-stroke: 2px var(--mustard);
            }

        .chat-hero p {
            margin-top: 18px;
            max-width: 48ch;
            color: rgba(250,250,247,.7);
        }

    .chat .container {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 32px;
        align-items: start;
    }

    .chat-box {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 22px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 620px;
    }

    .chat-head {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 22px;
        border-bottom: 1px solid var(--line);
    }

        .chat-head .avatar {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: var(--char);
            color: var(--mustard);
            display: grid;
            place-items: center;
            font-size: 20px;
            position: relative;
        }

            .chat-head .avatar::after {
                content: "";
                position: absolute;
                right: 0;
                bottom: 0;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #3ddc84;
                border: 2px solid #fff;
            }

        .chat-head strong {
            display: block;
        }

        .chat-head span {
            font-size: 13px;
            color: var(--muted);
        }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 24px 22px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        background: var(--paper);
    }

    .chat-day {
        align-self: center;
        font-size: 12px;
        color: var(--muted);
        background: #fff;
        border: 1px solid var(--line);
        padding: 4px 12px;
        border-radius: 999px;
    }

    .msg {
        max-width: 75%;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .msg .bubble {
            padding: 12px 16px;
            border-radius: 18px;
            line-height: 1.45;
            font-size: 15px;
        }

        .msg .time {
            font-size: 11px;
            color: var(--muted);
        }

        .msg.admin {
            align-self: flex-start;
        }

            .msg.admin .bubble {
                background: #fff;
                border: 1px solid var(--line);
                border-bottom-left-radius: 6px;
            }

        .msg.me {
            align-self: flex-end;
            align-items: flex-end;
        }

            .msg.me .bubble {
                background: var(--char);
                color: var(--paper);
                border-bottom-right-radius: 6px;
            }

    .chat-form {
        display: flex;
        gap: 10px;
        padding: 16px;
        border-top: 1px solid var(--line);
        background: #fff;
    }

        .chat-form input {
            flex: 1;
            min-width: 0;
            font: inherit;
            padding: 14px 18px;
            border: 1.5px solid var(--line);
            border-radius: 999px;
            background: var(--paper);
            color: var(--char);
        }

            .chat-form input:focus {
                outline: none;
                border-color: var(--char);
            }

        .chat-form button {
            width: 52px;
            height: 52px;
            flex: none;
            border-radius: 50%;
            border: 0;
            background: var(--ketchup);
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            transition: background .2s;
        }

            .chat-form button:hover {
                background: var(--ketchup-dark);
            }

    .chat-info {
        background: var(--char);
        color: var(--paper);
        border-radius: 22px;
        padding: 30px;
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

        .chat-info h3 {
            font-family: var(--display);
            font-size: 34px;
            font-weight: 900;
            line-height: 1;
        }

    .chat-name label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .chat-name strong {
        font-size: 20px;
        color: var(--mustard);
    }

    .chat-info .info-row {
        display: flex;
        gap: 14px;
    }

        .chat-info .info-row i {
            width: 42px;
            height: 42px;
            flex: none;
            border-radius: 12px;
            background: var(--char-soft);
            color: var(--mustard);
            display: grid;
            place-items: center;
            font-size: 18px;
        }

        .chat-info .info-row strong {
            display: block;
        }

        .chat-info .info-row span {
            font-size: 14px;
            color: rgba(250,250,247,.7);
        }

    @@media (max-width: 980px) {
        .chat .container {
            grid-template-columns: 1fr;
        }

        .chat-box {
            height: 520px;
        }
    }
</style>

<!-- ==================== HERO ==================== -->
<section class="chat-hero">
    <div class="container">
        <div class="crumb"><a href="/">Ana Sayfa</a> / Canlı Destek</div>
        <h1>Bize<br /><span class="stroke">yaz,</span><br />hemen dönelim.</h1>
        <p>Rezervasyon, menü ya da siparişinle ilgili bir sorun mu var? Ekibimiz çevrimiçi, birkaç dakika içinde cevap veriyoruz.</p>
    </div>
</section>

<!-- ==================== CHAT ==================== -->
<section class="section chat">
    <div class="container">

        <div class="chat-box">
            <div class="chat-head">
                <div class="avatar"><i class="fa fa-headphones"></i></div>
                <div>
                    <strong>GastroMaster Destek</strong>
                    <span>Çevrimiçi · Genelde birkaç dakikada yanıt verir</span>
                </div>
            </div>

            <div class="chat-messages" id="chatMessages">
                <div class="chat-day">Bugün</div>
            </div>

            <form class="chat-form" id="chatForm" onsubmit="return false;">
                <input type="text" id="chatInput" placeholder="Mesajını yaz..." autocomplete="off" maxlength="500" />
                <button type="submit" aria-label="Gönder"><i class="fa fa-paper-plane"></i></button>
            </form>
        </div>

        <aside class="chat-info">
            <h3>Sohbete başla</h3>

            <div class="chat-name">
                <label>Merhaba</label>
                <strong>@(User.Identity.IsAuthenticated ? User.Identity.Name : "Misafir")</strong>
            </div>

            <div class="info-row"><i class="fa fa-clock-o"></i><div><strong>Destek saatleri</strong><span>Her gün 11:00 – 23:00</span></div></div>
            <div class="info-row"><i class="fa fa-phone"></i><div><strong>Acil durumda</strong><span>0216 345 67 89</span></div></div>
            <div class="info-row"><i class="fa fa-lock"></i><div><strong>Gizlilik</strong><span>Mesajlar sohbetteki herkes tarafından görülür.</span></div></div>
        </aside>

    </div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    var userName = "@(User.Identity.IsAuthenticated ? User.Identity.Name : "Misafir")";

    var messageConnection = new signalR.HubConnectionBuilder()
        .withUrl("https://localhost:7139/SignalRHub")
        .withAutomaticReconnect()
        .build();

    messageConnection.on("ReceiveMessage", function (user, message) {
        var time = new Date().toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
        var item = $("<div>").addClass(user == userName ? "msg me" : "msg admin");
        $("<div>").addClass("bubble").text(user == userName ? message : user + ": " + message).appendTo(item);
        $("<div>").addClass("time").text(time).appendTo(item);
        $("#chatMessages").append(item);
        $("#chatMessages").scrollTop($("#chatMessages")[0].scrollHeight);
    });

    $("#chatForm").on("submit", function () {
        var message = $("#chatInput").val().trim();
        if (message == "") return;

        messageConnection.invoke("SendMessage", userName, message);
        $("#chatInput").val("");
    });

    messageConnection.start();
</script>