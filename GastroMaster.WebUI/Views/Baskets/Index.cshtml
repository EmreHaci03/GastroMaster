@model List<ResultBasketWithDetailsDto>
@{
    ViewData["Title"] = "Sepetim";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<style>
    .basket-hero {
        background: var(--char);
        color: var(--paper);
        padding: 70px 0 80px;
    }

        .basket-hero .crumb {
            font-size: 14px;
            color: rgba(250,250,247,.6);
            margin-bottom: 14px;
        }

            .basket-hero .crumb a:hover {
                color: var(--mustard);
            }

        .basket-hero h1 {
            font-family: var(--display);
            font-weight: 900;
            font-size: clamp(48px, 7vw, 96px);
            line-height: .9;
            text-transform: uppercase;
        }

            .basket-hero h1 .stroke {
                color: transparent;
                -webkit-text-stroke: 2px var(--mustard);
            }

        .basket-hero .table-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 20px;
            padding: 8px 16px;
            border-radius: 999px;
            background: rgba(255,255,255,.08);
            font-weight: 600;
        }

            .basket-hero .table-pill i {
                color: var(--mustard);
            }

    .basket .container {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 32px;
        align-items: start;
    }

    .basket-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .basket-item {
        display: grid;
        grid-template-columns: 96px 1fr auto;
        gap: 20px;
        align-items: center;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 16px;
    }

    .basket-item-img {
        width: 96px;
        height: 96px;
        border-radius: 14px;
        background: var(--char);
        display: grid;
        place-items: center;
        padding: 10px;
    }

        .basket-item-img img {
            max-height: 100%;
            object-fit: contain;
        }

    .basket-item h3 {
        font-size: 19px;
        margin-bottom: 4px;
    }

    .basket-item .unit-price {
        color: var(--muted);
        font-size: 14px;
    }

    .qty {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 12px;
        background: var(--paper);
        border: 1.5px solid var(--line);
        border-radius: 999px;
        padding: 4px;
    }

        .qty button {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 0;
            background: #fff;
            color: var(--char);
            font-size: 14px;
            cursor: pointer;
            transition: background .2s, color .2s;
        }

            .qty button:hover {
                background: var(--char);
                color: var(--paper);
            }

        .qty span {
            min-width: 28px;
            text-align: center;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

    .basket-item-side {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 14px;
    }

    .basket-item .line-total {
        font-family: var(--display);
        font-weight: 800;
        font-size: 28px;
        font-variant-numeric: tabular-nums;
    }

    .remove-btn {
        border: 0;
        background: none;
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .remove-btn:hover {
            color: var(--ketchup);
        }

    .basket-summary {
        position: sticky;
        top: 100px;
        background: var(--char);
        color: var(--paper);
        border-radius: 22px;
        padding: 30px;
    }

        .basket-summary h3 {
            font-family: var(--display);
            font-size: 34px;
            font-weight: 900;
            line-height: 1;
            margin-bottom: 22px;
        }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        color: rgba(250,250,247,.75);
        font-variant-numeric: tabular-nums;
    }

        .summary-row.total {
            margin-top: 10px;
            padding-top: 18px;
            border-top: 1px dashed rgba(255,255,255,.2);
            color: var(--paper);
            font-weight: 700;
            font-size: 18px;
        }

            .summary-row.total strong {
                font-family: var(--display);
                font-size: 36px;
                color: var(--mustard);
            }

        .summary-row.discount {
            color: #6ee7a0;
            font-weight: 600;
        }

    .coupon-box {
        margin: 14px 0 6px;
        padding: 16px;
        border-radius: 14px;
        background: rgba(255,255,255,.06);
        border: 1px dashed rgba(242,183,5,.4);
    }

        .coupon-box label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 10px;
            color: var(--paper);
        }

            .coupon-box label i {
                color: var(--mustard);
            }

    .coupon-input {
        display: flex;
        gap: 6px;
        background: var(--paper);
        border-radius: 999px;
        padding: 5px;
    }

        .coupon-input input {
            flex: 1;
            min-width: 0;
            border: 0;
            background: none;
            padding: 0 14px;
            font: inherit;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: var(--char);
        }

            .coupon-input input::placeholder {
                text-transform: none;
                letter-spacing: 0;
                font-weight: 400;
                color: #a39b91;
            }

            .coupon-input input:focus {
                outline: none;
            }

        .coupon-input button {
            border: 0;
            border-radius: 999px;
            padding: 9px 18px;
            background: var(--char);
            color: var(--mustard);
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s;
        }

            .coupon-input button:hover {
                background: var(--char-soft);
            }

    .coupon-message {
        margin-top: 8px;
        font-size: 13px;
        min-height: 18px;
    }

        .coupon-message.success {
            color: #6ee7a0;
        }

        .coupon-message.error {
            color: #ff8a80;
        }

    .basket-summary .btn {
        width: 100%;
        justify-content: center;
        margin-top: 24px;
    }

    .basket-summary .btn-ghost {
        color: var(--paper);
        margin-top: 10px;
    }

        .basket-summary .btn-ghost:hover {
            background: var(--paper);
            color: var(--char);
            border-color: var(--paper);
        }

    .summary-note {
        margin-top: 18px;
        font-size: 13px;
        color: rgba(250,250,247,.55);
        display: flex;
        gap: 8px;
    }

    .basket-empty {
        text-align: center;
        background: #fff;
        border: 1px dashed var(--line);
        border-radius: 18px;
        padding: 60px 20px;
        color: var(--muted);
    }

        .basket-empty i {
            font-size: 48px;
            color: var(--line);
            margin-bottom: 12px;
            display: block;
        }

    @@media (max-width: 980px) {
        .basket .container {
            grid-template-columns: 1fr;
        }

        .basket-summary {
            position: static;
        }
    }

    @@media (max-width: 620px) {
        .basket-item {
            grid-template-columns: 72px 1fr;
        }

        .basket-item-img {
            width: 72px;
            height: 72px;
        }

        .basket-item-side {
            grid-column: 1 / -1;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
        }
    }
</style>

<!-- ==================== HERO ==================== -->
<section class="basket-hero">
    <div class="container">
        <div class="crumb"><a href="/">Ana Sayfa</a> / Sepetim</div>
        <h1>Sepetin<br /><span class="stroke">hazır</span></h1>
        <span class="table-pill"><i class="fa fa-cutlery"></i> <span id="basketTableName">Masa @ViewBag.TableId</span></span>
    </div>
</section>

<!-- ==================== BASKET ==================== -->
<section class="section basket">
    <div class="container">

        <div class="basket-list" id="basketList">
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <article class="basket-item">
                        <div class="basket-item-img"><img src="@item.ProductImageUrl" alt="@item.Product" /></div>
                        <div>
                            <h3>@item.Product</h3>
                            <div class="unit-price">Birim fiyat ₺@item.Price.ToString("N0")</div>
                            <div class="qty">
                                <button type="button" aria-label="Azalt"><i class="fa fa-minus"></i></button>
                                <span>@item.Count</span>
                                <button type="button" aria-label="Artır"><i class="fa fa-plus"></i></button>
                            </div>
                        </div>
                        <div class="basket-item-side">
                            <div class="line-total">₺@item.TotalPrice.ToString("N0")</div>
                            <a href="/Baskets/DeleteBasket/@item.BasketId" class="remove-btn"><i class="fa fa-trash"></i> Kaldır</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="basket-empty">
                    <i class="fa fa-shopping-bag"></i>
                    <p class="mb-0">Sepetin şimdilik boş. Menüden bir şeyler ekle.</p>
                </div>
            }
        </div>

        <aside class="basket-summary">
            <h3>Sipariş özeti</h3>
            <div class="summary-row"><span>Ürün adedi</span><span id="basketItemCount">@Model.Sum(x => x.Count)</span></div>
            <div class="summary-row"><span>Ara toplam</span><span>₺<span id="basketSubTotal">@Model.Sum(x => x.TotalPrice).ToString("N0")</span></span></div>
            <div class="summary-row"><span>Servis ücreti</span><span>₺0</span></div>

            <div class="coupon-box">
                <label for="couponCode"><i class="fa fa-ticket"></i> Kupon kodun var mı?</label>
                <div class="coupon-input">
                    <input type="text" id="couponCode" name="CouponCode" placeholder="Örn: PERSEMBE20" autocomplete="off" />
                    <button type="button" id="couponApply">Uygula</button>
                </div>
                <div class="coupon-message" id="couponMessage"></div>
            </div>

            <div class="summary-row discount" id="couponRow" hidden>
                <span><i class="fa fa-tag"></i> İndirim (<span id="couponName">PERSEMBE20</span>)</span>
                <span>-₺<span id="couponAmount">0</span></span>
            </div>

            <div class="summary-row total"><span>Toplam</span><strong>₺<span id="basketTotal">@Model.Sum(x => x.TotalPrice).ToString("N0")</span></strong></div>

            <a href="/Baskets/Index" class="btn btn-primary"><i class="fa fa-check"></i> Siparişi ver</a>
            <a href="/#menu" class="btn btn-ghost">Menüye dön</a>

            <p class="summary-note"><i class="fa fa-clock-o"></i> Siparişin ortalama 15 dakikada masanda.</p>
        </aside>

    </div>
</section>