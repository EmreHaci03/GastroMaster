@model List<ResultContactDto>

<footer class="footer">
    <div class="container">
        @foreach (var item in Model)
        {
            <div class="footer-grid">
                <div>
                    <a href="/" class="logo">Gastro<span>Master</span></a>
                    <p>@item.FooterDescription</p>
                    @await Component.InvokeAsync("LayoutFooterSocial")
                </div>
                <div>
                    <h4>İletişim</h4>
                    <ul class="footer-list">
                        <li><i class="fa fa-map-marker"></i> @item.Location</li>
                        <li><i class="fa fa-phone"></i> <a href="tel:@item.Phone">@item.Phone</a></li>
                        <li><i class="fa fa-envelope"></i> <a href="mailto:@item.Mail">@item.Mail</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Sayfalar</h4>
                    <ul class="footer-list">
                        <li><a href="/#menu">Menü</a></li>
                        <li><a href="/About/Index">Hakkımızda</a></li>
                        <li><a href="/#rezervasyon">Rezervasyon</a></li>
                    </ul>
                </div>
            </div>
        }
        <div class="footer-bottom">
            <span>© <span id="year"></span> GastroMaster. Tüm hakları saklıdır.</span>
            <span>Kadıköy, İstanbul</span>
        </div>
    </div>
</footer>