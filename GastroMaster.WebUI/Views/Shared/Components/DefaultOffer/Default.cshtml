<section class="offers">
    <div class="container" id="offerList">

    </div>
</section>

<script>
    var offerConnection = new signalR.HubConnectionBuilder()
        .withUrl("https://localhost:7139/SignalRHub")
        .withAutomaticReconnect()
        .build();

    offerConnection.on("ReceiveTrueStatusDiscount", function (data) {
        var offerList = document.getElementById("offerList");
        offerList.innerHTML = "";

        for (var i = 0; i < data.length; i++) {
            offerList.innerHTML += `
                <article class="coupon">
                    <img src="${data[i].imageUrl}" alt="${data[i].title}" />
                    <div class="coupon-body">
                        <h3>${data[i].title}</h3>
                        <p>${data[i].description}</p>
                    </div>
                    <div class="coupon-stub">
                        <div class="coupon-amount">%${data[i].amount}<small>indirim</small></div>
                    </div>
                </article>`;
        }
    });

    offerConnection.start().then(function () {
        offerConnection.invoke("DefaultStatistic");
        setInterval(function () {
            if (offerConnection.state == signalR.HubConnectionState.Connected) {
                offerConnection.invoke("DefaultStatistic");
            }
        }, 5000);
    });
</script>