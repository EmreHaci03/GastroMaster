@model MaxPriceHamburgerDto

<div class="hero-visual">
    <div class="plate"></div>
    <img id="sliderBurgerImage" src="@Model.ImageUrl" alt="@Model.ProductName" />
    <div class="price-tag">
        <span>
            <strong id="sliderBurgerPrice">₺@Model.Price.ToString("N0")</strong>
            <span id="sliderBurgerName">@Model.ProductName</span>
        </span>
    </div>
</div>
