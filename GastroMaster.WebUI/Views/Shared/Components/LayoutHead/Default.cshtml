<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GastroMaster</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800;900&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />

    <style>
            :root {
              --ketchup: #d62828;
              --ketchup-dark: #a81e1e;
              --mustard: #f2b705;
              --pickle: #4f7a28;
              --char: #1e1b18;
              --char-soft: #3a3530;
              --paper: #fafaf7;
              --line: #e6e1d8;
              --muted: #6f675e;
              --display: "Big Shoulders Display", Impact, sans-serif;
              --body: "Figtree", system-ui, sans-serif;
            }

            * { box-sizing: border-box; margin: 0; padding: 0; }
            html { scroll-behavior: smooth; }
            body { font-family: var(--body); color: var(--char); background: var(--paper); line-height: 1.6; font-size: 17px; }
            img { max-width: 100%; display: block; }
            a { color: inherit; text-decoration: none; }
            button { font: inherit; cursor: pointer; }
            :focus-visible { outline: 3px solid var(--mustard); outline-offset: 3px; }

            .container { width: min(1180px, 100% - 40px); margin-inline: auto; }
            .section { padding: 110px 0; }
            .section-head { max-width: 640px; margin-bottom: 48px; }
            .section-head h2 { font-family: var(--display); font-weight: 900; font-size: clamp(44px, 6vw, 72px); line-height: .95; letter-spacing: -.5px; }
            .section-head p { color: var(--muted); margin-top: 14px; max-width: 52ch; }

            .btn { display: inline-flex; align-items: center; gap: 10px; padding: 15px 28px; border-radius: 999px; font-weight: 700; border: 2px solid transparent; transition: background .2s, color .2s, border-color .2s; }
            .btn-primary { background: var(--ketchup); color: #fff; }
            .btn-primary:hover { background: var(--ketchup-dark); }
            .btn-ghost { border-color: currentColor; }
            .btn-ghost:hover { background: var(--char); color: var(--paper); border-color: var(--char); }

            /* ---------- Header ---------- */
            .header { position: sticky; top: 0; z-index: 50; background: var(--char); color: var(--paper); }
            .header .container { display: flex; align-items: center; justify-content: space-between; height: 76px; }
            .logo { font-family: var(--display); font-weight: 900; font-size: 32px; letter-spacing: .5px; }
            .logo span { color: var(--mustard); }
            .nav { display: flex; gap: 34px; align-items: center; }
            .nav a { font-weight: 500; opacity: .8; transition: opacity .2s; }
            .nav a:hover, .nav a.active { opacity: 1; }
            .nav a.active { box-shadow: inset 0 -2px 0 var(--mustard); }
            .header-actions { display: flex; align-items: center; gap: 14px; }
            .header-actions .btn { padding: 11px 22px; font-size: 15px; }
            .icon-btn { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.2); background: none; color: inherit; }
            .menu-toggle { display: none; }

            /* ---------- Hero (Feature) ---------- */
            .hero { background: var(--char); color: var(--paper); overflow: hidden; }
            .hero .container { display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; min-height: calc(100vh - 76px); padding: 60px 0 90px; }
            .hero-slide { display: none; }
            .hero-slide.active { display: block; animation: heroIn .7s ease both; }
            .hero h1 { font-family: var(--display); font-weight: 900; font-size: clamp(64px, 10vw, 140px); line-height: .86; letter-spacing: -1px; text-transform: uppercase; }
            .hero h1 .stroke { color: transparent; -webkit-text-stroke: 2px var(--mustard); }
            .hero p { margin: 26px 0 36px; max-width: 46ch; color: rgba(250,250,247,.75); font-size: 18px; }
            .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
            .hero .btn-ghost { color: var(--paper); }
            .hero .btn-ghost:hover { background: var(--paper); color: var(--char); border-color: var(--paper); }
            .hero-dots { display: flex; gap: 10px; margin-top: 54px; }
            .hero-dots button { width: 34px; height: 5px; border: 0; border-radius: 3px; background: rgba(255,255,255,.25); transition: background .3s, width .3s; }
            .hero-dots button.active { background: var(--mustard); width: 56px; }

            .hero-visual { position: relative; justify-self: center; width: min(480px, 100%); aspect-ratio: 1; }
            .hero-visual .plate { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 50% 45%, var(--char-soft), var(--char) 70%); border: 2px dashed rgba(242,183,5,.35); }
            .hero-visual img { position: absolute; inset: 8%; width: 84%; height: 84%; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,.5)); }
            .price-tag { position: absolute; right: -6px; bottom: 14%; background: var(--mustard); color: var(--char); width: 118px; height: 118px; border-radius: 50%; display: grid; place-items: center; text-align: center; transform: rotate(-12deg); font-weight: 700; line-height: 1.1; }
            .price-tag strong { display: block; font-family: var(--display); font-size: 40px; font-weight: 900; }

              @@keyframes heroIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

            /* ---------- Offers (Discount) — kupon ---------- */
            .offers { margin-top: -60px; position: relative; z-index: 2; }
            .offers .container { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
            .coupon { display: grid; grid-template-columns: 150px 1fr auto; align-items: center; background: #fff; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 40px rgba(30,27,24,.12); position: relative; }
            .coupon img { width: 150px; height: 150px; object-fit: cover; background: var(--line); }
            .coupon-body { padding: 22px 26px; }
            .coupon-body h3 { font-size: 20px; font-weight: 700; }
            .coupon-body p { color: var(--muted); font-size: 15px; }
            .coupon-stub { align-self: stretch; display: grid; place-items: center; padding: 0 28px; border-left: 2px dashed var(--line); position: relative; }
            .coupon-stub::before, .coupon-stub::after { content: ""; position: absolute; left: -13px; width: 24px; height: 24px; border-radius: 50%; background: var(--paper); }
            .coupon-stub::before { top: -12px; }
            .coupon-stub::after { bottom: -12px; }
            .coupon-amount { font-family: var(--display); font-weight: 900; font-size: 46px; color: var(--ketchup); line-height: 1; text-align: center; }
            .coupon-amount small { display: block; font-family: var(--body); font-size: 13px; font-weight: 600; color: var(--muted); }

            /* ---------- Menu (Product + Category) — sipariş fişi ---------- */
            .filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 40px; }
            .filters button { padding: 10px 22px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; font-weight: 600; color: var(--char-soft); transition: all .2s; }
            .filters button:hover { border-color: var(--char); }
            .filters button.active { background: var(--char); border-color: var(--char); color: var(--paper); }

            .menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
            .ticket { background: #fff; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--line); }
            .ticket[hidden] { display: none; }
            .ticket-img { background: var(--char); height: 220px; display: grid; place-items: center; padding: 24px; position: relative; }
            .ticket-img img { max-height: 100%; object-fit: contain; transition: transform .35s; }
            .ticket:hover .ticket-img img { transform: scale(1.06) rotate(-2deg); }
            .ticket-cat { position: absolute; top: 16px; left: 16px; background: var(--mustard); color: var(--char); font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 999px; }
            .ticket-body { padding: 22px 24px 8px; flex: 1; }
            .ticket-body h3 { font-size: 21px; font-weight: 700; margin-bottom: 6px; }
            .ticket-body p { color: var(--muted); font-size: 15px; }
            .ticket-foot { display: flex; align-items: center; justify-content: space-between; padding: 18px 24px 22px; margin-top: 14px; border-top: 2px dashed var(--line); position: relative; }
            .ticket-foot::before, .ticket-foot::after { content: ""; position: absolute; top: -12px; width: 22px; height: 22px; border-radius: 50%; background: var(--paper); border: 1px solid var(--line); }
            .ticket-foot::before { left: -12px; }
            .ticket-foot::after { right: -12px; }
            .ticket-price { font-family: var(--display); font-weight: 800; font-size: 32px; font-variant-numeric: tabular-nums; }
            .add-btn { width: 46px; height: 46px; border-radius: 50%; border: 0; background: var(--ketchup); color: #fff; font-size: 18px; transition: background .2s; }
            .add-btn:hover { background: var(--ketchup-dark); }
            .menu-more { text-align: center; margin-top: 48px; }

            /* ---------- About ---------- */
            .about { background: var(--mustard); }
            .about .container { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: center; }
            .about-img { position: relative; }
            .about-img img { width: 100%; border-radius: 24px; background: rgba(0,0,0,.08); aspect-ratio: 4/3.4; object-fit: cover; }
            .about-badge { position: absolute; left: -24px; bottom: 30px; background: var(--char); color: var(--paper); padding: 20px 24px; border-radius: 16px; }
            .about-badge strong { display: block; font-family: var(--display); font-size: 44px; font-weight: 900; line-height: 1; color: var(--mustard); }
            .about .section-head p { color: var(--char-soft); }
            .about-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 34px 0; }
            .about-facts div { border-top: 2px solid var(--char); padding-top: 12px; }
            .about-facts strong { display: block; font-family: var(--display); font-size: 36px; font-weight: 900; line-height: 1; }
            .about-facts span { font-size: 14px; color: var(--char-soft); }

            /* ---------- Book (Booking) ---------- */
            .book .container { display: grid; grid-template-columns: 1.2fr .8fr; gap: 40px; }
            .book-form { background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 40px; }
            .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
            .field { display: flex; flex-direction: column; gap: 7px; }
            .field.full { grid-column: 1 / -1; }
            .field label { font-size: 14px; font-weight: 600; color: var(--char-soft); }
            .field input, .field select { font: inherit; padding: 14px 16px; border: 1.5px solid var(--line); border-radius: 12px; background: var(--paper); color: var(--char); }
            .field input:focus, .field select:focus { outline: none; border-color: var(--char); }
            .book-form .btn { margin-top: 26px; width: 100%; justify-content: center; }
            .book-info { background: var(--char); color: var(--paper); border-radius: 22px; padding: 40px; display: flex; flex-direction: column; gap: 28px; }
            .book-info h3 { font-family: var(--display); font-size: 36px; font-weight: 900; line-height: 1; }
            .info-row { display: flex; gap: 16px; }
            .info-row i { width: 44px; height: 44px; flex: none; border-radius: 12px; background: var(--char-soft); color: var(--mustard); display: grid; place-items: center; font-size: 18px; }
            .info-row strong { display: block; }
            .info-row span { color: rgba(250,250,247,.7); font-size: 15px; }
            .hours { margin-top: auto; border-top: 1px solid rgba(255,255,255,.15); padding-top: 22px; display: grid; gap: 8px; font-size: 15px; }
            .hours div { display: flex; justify-content: space-between; }
            .hours span:last-child { font-variant-numeric: tabular-nums; }

            /* ---------- Testimonials ---------- */
            .reviews { background: var(--char); color: var(--paper); }
            .reviews .section-head p { color: rgba(250,250,247,.7); }
            .reviews-wrap { display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: end; }
            .review { display: none; }
            .review.active { display: grid; grid-template-columns: auto 1fr; gap: 34px; align-items: center; animation: heroIn .5s ease both; }
            .review img { width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 4px solid var(--mustard); background: var(--char-soft); }
            .review blockquote { font-size: clamp(22px, 2.6vw, 30px); line-height: 1.35; font-weight: 500; max-width: 34ch; }
            .review cite { display: block; margin-top: 18px; font-style: normal; font-weight: 700; color: var(--mustard); }
            .review cite span { display: block; font-weight: 400; color: rgba(250,250,247,.6); font-size: 15px; }
            .review-nav { display: flex; gap: 10px; }
            .review-nav button { width: 54px; height: 54px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.3); background: none; color: var(--paper); font-size: 18px; transition: all .2s; }
            .review-nav button:hover { background: var(--mustard); border-color: var(--mustard); color: var(--char); }

            /* ---------- Footer (Contact + SocialMedia) ---------- */
            .footer { background: #141210; color: rgba(250,250,247,.75); padding: 80px 0 30px; }
            .footer-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 50px; }
            .footer .logo { color: var(--paper); display: inline-block; margin-bottom: 16px; }
            .footer h4 { color: var(--paper); font-size: 17px; margin-bottom: 18px; }
            .footer-list { list-style: none; display: grid; gap: 12px; }
            .footer-list i { color: var(--mustard); width: 22px; }
            .social { display: flex; gap: 10px; margin-top: 22px; }
            .social a { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.08); color: var(--paper); transition: background .2s, color .2s; }
            .social a:hover { background: var(--mustard); color: var(--char); }
            .footer-bottom { margin-top: 60px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.1); font-size: 14px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }

            /* ---------- Responsive ---------- */
            @@media (max-width: 980px) {
              .nav { position: fixed; inset: 76px 0 auto; background: var(--char); flex-direction: column; gap: 0; padding: 10px 20px 24px; display: none; }
              .nav.open { display: flex; }
              .nav a { padding: 14px 0; width: 100%; border-bottom: 1px solid rgba(255,255,255,.08); }
              .nav a.active { box-shadow: none; color: var(--mustard); }
              .menu-toggle { display: grid; }
              .header-actions .btn { display: none; }
              .hero .container { grid-template-columns: 1fr; min-height: auto; padding: 50px 0 110px; }
              .hero-visual { width: min(340px, 90%); order: -1; }
              .offers .container, .about .container, .book .container, .footer-grid { grid-template-columns: 1fr; }
              .menu-grid { grid-template-columns: repeat(2, 1fr); }
              .about-badge { left: 16px; }
            }
            @@media (max-width: 620px) {
              body { font-size: 16px; }
              .section { padding: 80px 0; }
              .menu-grid, .form-grid { grid-template-columns: 1fr; }
              .coupon { grid-template-columns: 96px 1fr; }
              .coupon img { width: 96px; height: 100%; }
              .coupon-stub { grid-column: 1 / -1; border-left: 0; border-top: 2px dashed var(--line); padding: 14px; }
              .coupon-stub::before, .coupon-stub::after { display: none; }
              .review.active { grid-template-columns: 1fr; }
              .reviews-wrap { grid-template-columns: 1fr; }
              .book-form, .book-info { padding: 28px; }
            }
            @@media (prefers-reduced-motion: reduce) {
              *, *::before, *::after { animation: none !important; transition: none !important; }
              html { scroll-behavior: auto; }
            }
    </style>
</head>