@model RegisterDto
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<section class="section">
    <div class="container" style="max-width:560px;">
        <div class="section-head" style="margin-bottom:28px;">
            <h2>Kayıt ol</h2>
            <p>Zaten hesabın var mı? <a href="/Account/Login/" style="color:var(--ketchup); font-weight:700;">Giriş yap</a></p>
        </div>

        <form method="post" class="book-form">
            <div asp-validation-summary="ModelOnly" style="color:var(--ketchup); margin-bottom:14px;"></div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Name">Ad</label>
                    <input asp-for="Name" />
                    <span asp-validation-for="Name" style="color:var(--ketchup); font-size:13px;"></span>
                </div>
                <div class="field">
                    <label asp-for="Surname">Soyad</label>
                    <input asp-for="Surname" />
                    <span asp-validation-for="Surname" style="color:var(--ketchup); font-size:13px;"></span>
                </div>
                <div class="field full">
                    <label asp-for="UserName">Kullanıcı adı</label>
                    <input asp-for="UserName" />
                    <span asp-validation-for="UserName" style="color:var(--ketchup); font-size:13px;"></span>
                </div>
                <div class="field full">
                    <label asp-for="Email">E-posta</label>
                    <input asp-for="Email" type="email" />
                    <span asp-validation-for="Email" style="color:var(--ketchup); font-size:13px;"></span>
                </div>
                <div class="field">
                    <label asp-for="Password">Şifre</label>
                    <input asp-for="Password" type="password" />
                    <span asp-validation-for="Password" style="color:var(--ketchup); font-size:13px;"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">Şifre tekrar</label>
                    <input asp-for="ConfirmPassword" type="password" />
                    <span asp-validation-for="ConfirmPassword" style="color:var(--ketchup); font-size:13px;"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Kayıt ol</button>
        </form>
    </div>
</section>