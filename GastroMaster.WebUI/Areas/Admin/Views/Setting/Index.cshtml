@model UserEditDto

@{
    ViewData["Title"] = "Ayarlar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .profile-card {
        text-align: center;
        padding: 30px 20px;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: rgba(21, 114, 232, .12);
        color: #1572e8;
        font-size: 40px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile-card h4 {
        font-weight: 700;
        margin-bottom: 4px;
    }

    .profile-card .profile-username {
        color: #8d9498;
        margin-bottom: 18px;
    }

    .profile-info {
        text-align: left;
        border-top: 1px solid #ebedf2;
        padding-top: 16px;
    }

        .profile-info div {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            color: #575962;
            word-break: break-all;
        }

        .profile-info i {
            font-size: 20px;
            color: #1572e8;
        }

    .setting-form .form-group label {
        font-weight: 600;
    }

    .setting-form .form-control {
        height: auto;
        padding: 10px 15px;
    }

    .setting-form .btn {
        border-radius: 25px;
        padding: 10px 28px;
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Ayarlar</h4>

        @if (TempData["SettingMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="la la-check-circle"></i> @TempData["SettingMessage"]
            </div>
        }

        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body profile-card">
                        <div class="profile-avatar">@(string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name.Substring(0, 1).ToUpper())</div>
                        <h4>@Model.Name @Model.Surname</h4>
                        <div class="profile-username">@@@Model.Username</div>
                        <div class="profile-info">
                            <div><i class="la la-envelope"></i> @Model.Email</div>
                            <div><i class="la la-shield"></i> Yönetici</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Profil Bilgileri</div>
                        <div class="card-category">Hesap bilgilerini buradan güncelleyebilirsin</div>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/Admin/Setting/Index" class="setting-form">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Name">Ad</label>
                                        <input asp-for="Name" class="form-control" placeholder="Adın" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Surname">Soyad</label>
                                        <input asp-for="Surname" class="form-control" placeholder="Soyadın" />
                                        <span asp-validation-for="Surname" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Username">Kullanıcı Adı</label>
                                        <input asp-for="Username" class="form-control" placeholder="Kullanıcı adın" />
                                        <span asp-validation-for="Username" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Email">E-posta</label>
                                        <input asp-for="Email" type="email" class="form-control" placeholder="ornek@mail.com" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <hr />
                            <h5 style="font-weight:600;">Şifre Değiştir</h5>
                            <p class="text-muted" style="font-size:13px;">Şifreni değiştirmek istemiyorsan bu alanları boş bırak.</p>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Password">Yeni Şifre</label>
                                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••" autocomplete="new-password" />
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="ConfirmPassword">Yeni Şifre (Tekrar)</label>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••" autocomplete="new-password" />
                                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="text-right mt-3">
                                <button type="submit" class="btn btn-primary">
                                    <i class="la la-save"></i> Kaydet
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>