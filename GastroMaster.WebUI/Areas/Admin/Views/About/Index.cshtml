@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Hakkımızda";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .about-card {
        border-radius: 12px;
        overflow: hidden;
    }

        .about-card .about-img {
            width: 100%;
            height: 100%;
            min-height: 260px;
            object-fit: cover;
            background: #f4f5f8;
        }

        .about-card .about-body {
            padding: 30px;
        }

        .about-card .about-title {
            font-weight: 700;
            font-size: 24px;
            margin-bottom: 15px;
        }

        .about-card .about-text {
            color: #6c757d;
            line-height: 1.8;
            white-space: pre-line;
        }

        .about-card .about-meta {
            font-size: 12px;
            color: #8d9498;
        }

    .delete-modal .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0, 0, 0, .2);
    }

    .delete-modal .modal-body {
        padding: 35px 30px 25px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(243, 84, 93, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: deletePulse 1.6s infinite;
    }

        .delete-modal .delete-icon i {
            font-size: 40px;
            color: #f3545d;
        }

    .delete-modal h4 {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .delete-modal .delete-name {
        display: inline-block;
        margin: 6px 0 14px;
        padding: 4px 14px;
        border-radius: 20px;
        background: #f4f5f8;
        font-weight: 600;
        color: #333;
    }

    .delete-modal .delete-warning {
        font-size: 13px;
        color: #8d9498;
        margin-bottom: 0;
    }

    .delete-modal .modal-footer {
        border-top: none;
        justify-content: center;
        padding: 0 30px 30px;
    }

        .delete-modal .modal-footer .btn {
            min-width: 130px;
            border-radius: 25px;
            font-weight: 500;
        }

    @@keyframes deletePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, .35);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(243, 84, 93, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, 0);
        }
    }
</style>

<div class="content">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="page-title mb-0">Hakkımızda</h4>
            @if (!Model.Any())
            {
                <a href="/Admin/About/CreateAbout" class="btn btn-primary">
                    <i class="la la-plus"></i> Hakkımızda Ekle
                </a>
            }
        </div>

        @if (Model.Count > 1)
        {
            <div class="alert alert-warning">
                <i class="la la-exclamation-triangle"></i>
                Birden fazla kayıt var. Sitede sadece ilk kayıt gösterilir, diğerlerini silebilirsiniz.
            </div>
        }

        @if (Model.Any())
        {
            int order = 1;
            @foreach (var item in Model)
            {
                <div class="card about-card" style="@(order > 1 ? "opacity:.6;" : "")">
                    <div class="row no-gutters">
                        <div class="col-md-5">
                            <img src="@item.ImageUrl" class="about-img" alt="@item.Title" />
                        </div>
                        <div class="col-md-7">
                            <div class="about-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="about-title">@item.Title</div>
                                    @if (order == 1)
                                    {
                                        <span class="badge badge-success"><i class="la la-desktop"></i> Sitede</span>
                                    }
                                </div>
                                <p class="about-text">@item.Description</p>
                                <p class="about-meta mb-3">
                                    <i class="la la-image"></i> @item.ImageUrl
                                </p>
                                <a href="/Admin/About/UpdateAbout/@item.AboutId" class="btn btn-warning btn-sm">
                                    <i class="la la-edit"></i> Güncelle
                                </a>
                                <button type="button" class="btn btn-danger btn-sm"
                                        data-toggle="modal" data-target="#deleteModal"
                                        data-name="@item.Title"
                                        data-url="/Admin/About/DeleteAbout/@item.AboutId"
                                        onclick="setDeleteModal(this)">
                                    <i class="la la-trash"></i> Sil
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                order++;
            }
        }
        else
        {
            <div class="card">
                <div class="card-body text-center text-muted py-5">
                    <i class="la la-info-circle" style="font-size:48px;"></i>
                    <h5 class="mt-3">Henüz hakkımızda bilgisi eklenmemiş</h5>
                    <p class="mb-3">Ana sayfadaki "About Us" bölümü boş görünecek.</p>
                    <a href="/Admin/About/CreateAbout" class="btn btn-primary">
                        <i class="la la-plus"></i> Şimdi Ekle
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon">
                    <i class="la la-trash"></i>
                </div>
                <h4>Hakkımızda Bilgisini Sil</h4>
                <p class="mb-0">Aşağıdaki kaydı silmek üzeresiniz:</p>
                <span class="delete-name" id="deleteName"></span>
                <p class="delete-warning">
                    <i class="la la-exclamation-triangle"></i>
                    Bu işlem geri alınamaz. Ana sayfadaki bölüm boş kalabilir.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="la la-close"></i> Vazgeç
                </button>
                <a href="#" id="deleteConfirm" class="btn btn-danger">
                    <i class="la la-trash"></i> Evet, Sil
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteModal(button) {
        document.getElementById("deleteName").innerText = button.getAttribute("data-name");
        document.getElementById("deleteConfirm").setAttribute("href", button.getAttribute("data-url"));
    }
</script>