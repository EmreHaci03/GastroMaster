@{
    ViewData["Title"] = "AI Asistan";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .ai-card .card-body {
        padding: 0;
    }

    .ai-area {
        min-height: 380px;
        max-height: 560px;
        overflow-y: auto;
        padding: 25px;
        background: #f9fbfd;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .ai-empty {
        margin: auto;
        text-align: center;
        color: #8d9498;
        max-width: 420px;
    }

        .ai-empty .ai-empty-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 16px;
            border-radius: 50%;
            background: rgba(111, 66, 193, .12);
            color: #6f42c1;
            font-size: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .ai-empty h4 {
            color: #222831;
            font-weight: 600;
        }

    .ai-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        max-width: 85%;
    }

        .ai-row.me {
            align-self: flex-end;
            flex-direction: row-reverse;
        }

    .ai-avatar {
        width: 38px;
        height: 38px;
        flex: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        background: rgba(111, 66, 193, .12);
        color: #6f42c1;
    }

    .ai-row.me .ai-avatar {
        background: rgba(21, 114, 232, .12);
        color: #1572e8;
    }

    .ai-bubble {
        padding: 12px 16px;
        border-radius: 14px;
        border-top-left-radius: 4px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
        font-size: 14px;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .ai-row.me .ai-bubble {
        background: #1572e8;
        color: #fff;
        border-top-left-radius: 14px;
        border-top-right-radius: 4px;
    }

    .ai-footer {
        padding: 16px 20px;
        border-top: 1px solid #ebedf2;
        background: #fff;
    }

    .ai-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }

        .ai-chips button {
            border: 1px solid #ebedf2;
            background: #f9fbfd;
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 13px;
            color: #575962;
            cursor: pointer;
            transition: all .2s;
        }

            .ai-chips button:hover {
                border-color: #6f42c1;
                color: #6f42c1;
            }

    .ai-form {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }

        .ai-form textarea {
            flex: 1;
            resize: none;
            border-radius: 14px;
            padding: 12px 16px;
        }

        .ai-form .btn {
            border-radius: 25px;
            padding: 10px 24px;
            white-space: nowrap;
        }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">AI Asistan</h4>

        <div class="row">
            <div class="col-md-12">
                <div class="card ai-card">
                    <div class="card-header">
                        <div class="card-title"><i class="la la-magic"></i> GastroMaster Asistan</div>
                        <div class="card-category">Kampanya metni, şikayet cevabı, menü fikri... Ne lazımsa sor</div>
                    </div>
                    <div class="card-body">
                        <div class="ai-area">
                            @if (ViewBag.Message == null)
                            {
                                <div class="ai-empty">
                                    <div class="ai-empty-icon"><i class="la la-magic"></i></div>
                                    <h4>Nasıl yardımcı olabilirim?</h4>
                                    <p class="mb-0">Aşağıdaki örneklerden birini seçebilir ya da kendi sorunu yazabilirsin.</p>
                                </div>
                            }
                            else
                            {
                                <div class="ai-row me">
                                    <div class="ai-avatar"><i class="la la-user"></i></div>
                                    <div class="ai-bubble">@ViewBag.Message</div>
                                </div>

                                @if (ViewBag.Answer != null)
                                {
                                    <div class="ai-row">
                                        <div class="ai-avatar"><i class="la la-magic"></i></div>
                                        <div class="ai-bubble">@ViewBag.Answer</div>
                                    </div>
                                }
                            }

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger mb-0">
                                    <i class="la la-exclamation-triangle"></i> @ViewBag.Error
                                </div>
                            }
                        </div>

                        <div class="ai-footer">
                            <div class="ai-chips">
                                <button type="button" data-text="Hafta sonu için bir kampanya fikri ver">Kampanya fikri</button>
                                <button type="button" data-text="Yeni burgerimiz için bir Instagram paylaşımı yaz">Instagram paylaşımı</button>
                                <button type="button" data-text="Siparişi geç gelen bir müşterinin şikayetine kibar bir cevap yaz">Şikayet cevabı</button>
                                <button type="button" data-text="Menümüze ekleyebileceğimiz 3 yeni makarna öner">Menü fikri</button>
                            </div>

                            <form method="post" action="/Admin/AI/AIChat" class="ai-form" id="aiForm">
                                @Html.AntiForgeryToken()
                                <textarea name="message" id="aiInput" class="form-control" rows="2" maxlength="2000" placeholder="Mesajını yaz..."></textarea>
                                <button type="submit" class="btn btn-primary" id="aiSend">
                                    <i class="la la-send"></i> Gönder
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var aiInput = document.getElementById("aiInput");
    var aiSend = document.getElementById("aiSend");

    document.querySelectorAll(".ai-chips button").forEach(function (chip) {
        chip.addEventListener("click", function () {
            aiInput.value = chip.getAttribute("data-text");
            aiInput.focus();
        });
    });

    aiInput.addEventListener("keydown", function (e) {
        if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            document.getElementById("aiForm").requestSubmit();
        }
    });

    document.getElementById("aiForm").addEventListener("submit", function (e) {
        if (aiInput.value.trim() === "") {
            e.preventDefault();
            return;
        }
        aiSend.disabled = true;
        aiSend.innerHTML = '<i class="la la-spinner la-spin"></i> Düşünüyor...';
    });
</script>