@{
    ViewData["Title"] = "Geri Bildirim Analizi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .analysis-intro {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .analysis-icon {
        width: 64px;
        height: 64px;
        flex: none;
        border-radius: 50%;
        background: rgba(111, 66, 193, .12);
        color: #6f42c1;
        font-size: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .analysis-intro h4 {
        font-weight: 600;
        margin-bottom: 4px;
    }

    .analysis-intro p {
        color: #8d9498;
        margin: 0;
    }

    .analysis-result {
        white-space: pre-wrap;
        line-height: 1.8;
        font-size: 14px;
        color: #222831;
        background: #f9fbfd;
        border-left: 4px solid #6f42c1;
        border-radius: 8px;
        padding: 20px 24px;
    }

    .analysis-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
        font-size: 13px;
        color: #8d9498;
    }

    .analysis-empty {
        text-align: center;
        color: #8d9498;
        padding: 40px 20px;
    }

        .analysis-empty i {
            font-size: 48px;
            color: #d5d9dd;
            display: block;
            margin-bottom: 10px;
        }

    .analysis-btn {
        border-radius: 25px;
        padding: 10px 26px;
        white-space: nowrap;
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Geri Bildirim Analizi</h4>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <div class="analysis-intro">
                            <div class="analysis-icon"><i class="la la-magic"></i></div>
                            <div style="flex:1;">
                                <h4>Yapay zekâ ile geri bildirim analizi</h4>
                                <p>Son 50 geri bildirim okunur. Genel durum, öne çıkan sorunlar, öneriler ve acil ilgilenilmesi gerekenler özetlenir.</p>
                            </div>
                            <form method="post" action="/Admin/AI/FeedbackAnalysis" id="analysisForm">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary analysis-btn" id="analysisButton">
                                    <i class="la la-magic"></i> @(ViewBag.Answer != null ? "Tekrar Analiz Et" : "Analiz Et")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <div class="card-title">Analiz Sonucu</div>
                            <div class="card-category">Sonuçlar yapay zekâ tarafından üretilir, karar vermeden önce geri bildirimleri kontrol edin</div>
                        </div>
                        <a href="/Admin/FeedBacks/Index" class="btn btn-default btn-sm">
                            <i class="la la-arrow-left"></i> Geri Bildirimlere Dön
                        </a>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger mb-0">
                                <i class="la la-exclamation-triangle"></i> @ViewBag.Error
                            </div>
                        }
                        else if (ViewBag.Answer != null)
                        {
                            <div class="analysis-result">@ViewBag.Answer</div>
                            <div class="analysis-meta">
                                <span><i class="la la-inbox"></i> @ViewBag.Count geri bildirim analiz edildi</span>
                                <span><i class="la la-clock-o"></i> @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                        }
                        else
                        {
                            <div class="analysis-empty">
                                <i class="la la-bar-chart"></i>
                                Henüz analiz yapılmadı. Başlamak için yukarıdaki <strong>Analiz Et</strong> butonuna bas.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("analysisForm").addEventListener("submit", function () {
        var button = document.getElementById("analysisButton");
        button.disabled = true;
        button.innerHTML = '<i class="la la-spinner la-spin"></i> Analiz ediliyor...';
    });
</script>