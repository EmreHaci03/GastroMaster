@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "Referanslar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .testimonial-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #ffbe33;
        background: #f4f5f8;
    }

    .testimonial-comment {
        font-style: italic;
        color: #6c757d;
    }

    .delete-modal .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0, 0, 0, .2);
    }

    .delete-modal .modal-body {
        padding: 35px 30px 25px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(243, 84, 93, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: deletePulse 1.6s infinite;
    }

        .delete-modal .delete-icon i {
            font-size: 40px;
            color: #f3545d;
        }

    .delete-modal h4 {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .delete-modal .delete-name {
        display: inline-block;
        margin: 6px 0 14px;
        padding: 4px 14px;
        border-radius: 20px;
        background: #f4f5f8;
        font-weight: 600;
        color: #333;
    }

    .delete-modal .delete-warning {
        font-size: 13px;
        color: #8d9498;
        margin-bottom: 0;
    }

    .delete-modal .modal-footer {
        border-top: none;
        justify-content: center;
        padding: 0 30px 30px;
    }

        .delete-modal .modal-footer .btn {
            min-width: 130px;
            border-radius: 25px;
            font-weight: 500;
        }

    @@keyframes deletePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, .35);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(243, 84, 93, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, 0);
        }
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Referanslar</h4>

        <div class="row">
            <div class="col-md-6">
                <div class="card card-stats card-primary">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-comments"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Toplam Yorum</p>
                                    <h4 class="card-title">@Model.Count</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card card-stats card-warning">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-quote-left"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Ort. Yorum Uzunluğu</p>
                                    <h4 class="card-title">@(Model.Any() ? Math.Round(Model.Average(x => (x.Comment ?? "").Length)) : 0) krk</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <div class="card-title">Müşteri Yorumları</div>
                            <div class="card-category">Ana sayfadaki "What Says Our Customers" bölümünde gösterilir</div>
                        </div>
                        <a href="/Admin/Testimonial/CreateTestimonial" class="btn btn-primary">
                            <i class="la la-plus"></i> Yeni Yorum
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mt-3">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Müşteri</th>
                                        <th scope="col">Yorum</th>
                                        <th scope="col" class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.TestimonialId</td>
                                                <td style="min-width:200px;">
                                                    <div class="d-flex align-items-center">
                                                        <img src="@item.ImageUrl" class="testimonial-avatar mr-3" alt="@item.Name" />
                                                        <div>
                                                            <strong>@item.Name</strong>
                                                            <div class="small text-muted">@item.Title</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="testimonial-comment">
                                                    <i class="la la-quote-left"></i>
                                                    @(item.Comment?.Length > 90 ? item.Comment.Substring(0, 90) + "..." : item.Comment)
                                                </td>
                                                <td class="text-center" style="white-space:nowrap;">
                                                    <a href="/Admin/Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-warning btn-sm" title="Güncelle">
                                                        <i class="la la-edit"></i> Güncelle
                                                    </a>
                                                    <button type="button" class="btn btn-danger btn-sm" title="Sil"
                                                            data-toggle="modal" data-target="#deleteModal"
                                                            data-name="@item.Name"
                                                            data-url="/Admin/Testimonial/DeleteTestimonial/@item.TestimonialId"
                                                            onclick="setDeleteModal(this)">
                                                        <i class="la la-trash"></i> Sil
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="la la-inbox" style="font-size:32px;"></i>
                                                <p class="mb-0">Henüz müşteri yorumu eklenmemiş.</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon">
                    <i class="la la-trash"></i>
                </div>
                <h4>Yorumu Sil</h4>
                <p class="mb-0">Aşağıdaki müşterinin yorumunu silmek üzeresiniz:</p>
                <span class="delete-name" id="deleteName"></span>
                <p class="delete-warning">
                    <i class="la la-exclamation-triangle"></i>
                    Bu işlem geri alınamaz.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="la la-close"></i> Vazgeç
                </button>
                <a href="#" id="deleteConfirm" class="btn btn-danger">
                    <i class="la la-trash"></i> Evet, Sil
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteModal(button) {
        document.getElementById("deleteName").innerText = button.getAttribute("data-name");
        document.getElementById("deleteConfirm").setAttribute("href", button.getAttribute("data-url"));
    }
</script>