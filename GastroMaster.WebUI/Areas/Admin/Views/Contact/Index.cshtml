@model List<ResultContactDto>

@{
    ViewData["Title"] = "İletişim";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .contact-info-card {
        border-radius: 12px;
        text-align: center;
        padding: 28px 20px;
        height: 100%;
    }

        .contact-info-card .info-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 15px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: #fff;
        }

        .contact-info-card .info-label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #8d9498;
            margin-bottom: 6px;
        }

        .contact-info-card .info-value {
            font-weight: 600;
            word-break: break-word;
        }

    .footer-desc {
        color: #6c757d;
        line-height: 1.8;
        white-space: pre-line;
    }

    .delete-modal .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0, 0, 0, .2);
    }

    .delete-modal .modal-body {
        padding: 35px 30px 25px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(243, 84, 93, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: deletePulse 1.6s infinite;
    }

        .delete-modal .delete-icon i {
            font-size: 40px;
            color: #f3545d;
        }

    .delete-modal h4 {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .delete-modal .delete-name {
        display: inline-block;
        margin: 6px 0 14px;
        padding: 4px 14px;
        border-radius: 20px;
        background: #f4f5f8;
        font-weight: 600;
        color: #333;
    }

    .delete-modal .delete-warning {
        font-size: 13px;
        color: #8d9498;
        margin-bottom: 0;
    }

    .delete-modal .modal-footer {
        border-top: none;
        justify-content: center;
        padding: 0 30px 30px;
    }

        .delete-modal .modal-footer .btn {
            min-width: 130px;
            border-radius: 25px;
            font-weight: 500;
        }

    @@keyframes deletePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, .35);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(243, 84, 93, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, 0);
        }
    }
</style>

<div class="content">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="page-title mb-0">İletişim Bilgileri</h4>
            @if (!Model.Any())
            {
                <a href="/Admin/Contact/CreateContact" class="btn btn-primary">
                    <i class="la la-plus"></i> İletişim Bilgisi Ekle
                </a>
            }
        </div>

        @if (Model.Count > 1)
        {
            <div class="alert alert-warning">
                <i class="la la-exclamation-triangle"></i>
                Birden fazla kayıt var. Sitede sadece ilk kayıt gösterilir, diğerlerini silebilirsiniz.
            </div>
        }

        @if (Model.Any())
        {
            int order = 1;
            @foreach (var item in Model)
            {
                <div class="card" style="@(order > 1 ? "opacity:.6;" : "")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <div class="card-title">
                                Kayıt #@item.ContactId
                                @if (order == 1)
                                {
                                    <span class="badge badge-success ml-2"><i class="la la-desktop"></i> Sitede</span>
                                }
                            </div>
                            <div class="card-category">Sitenin footer ve iletişim alanlarında gösterilir</div>
                        </div>
                        <div style="white-space:nowrap;">
                            <a href="/Admin/Contact/UpdateContact/@item.ContactId" class="btn btn-warning btn-sm">
                                <i class="la la-edit"></i> Güncelle
                            </a>
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-toggle="modal" data-target="#deleteModal"
                                    data-name="@item.Mail"
                                    data-url="/Admin/Contact/DeleteContact/@item.ContactId"
                                    onclick="setDeleteModal(this)">
                                <i class="la la-trash"></i> Sil
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="card contact-info-card mb-0">
                                    <div class="info-icon" style="background:#1572e8;"><i class="la la-map-marker"></i></div>
                                    <div class="info-label">Adres</div>
                                    <div class="info-value">@item.Location</div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card contact-info-card mb-0">
                                    <div class="info-icon" style="background:#31ce36;"><i class="la la-phone"></i></div>
                                    <div class="info-label">Telefon</div>
                                    <div class="info-value">@item.Phone</div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card contact-info-card mb-0">
                                    <div class="info-icon" style="background:#ffad46;"><i class="la la-envelope"></i></div>
                                    <div class="info-label">E-posta</div>
                                    <div class="info-value">@item.Mail</div>
                                </div>
                            </div>
                        </div>
                        <h6 class="mt-2"><i class="la la-align-left"></i> Footer Açıklaması</h6>
                        <p class="footer-desc mb-0">@item.FooterDescription</p>
                    </div>
                </div>
                order++;
            }
        }
        else
        {
            <div class="card">
                <div class="card-body text-center text-muted py-5">
                    <i class="la la-address-book" style="font-size:48px;"></i>
                    <h5 class="mt-3">Henüz iletişim bilgisi eklenmemiş</h5>
                    <p class="mb-3">Sitenin footer kısmı boş görünecek.</p>
                    <a href="/Admin/Contact/CreateContact" class="btn btn-primary">
                        <i class="la la-plus"></i> Şimdi Ekle
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon">
                    <i class="la la-trash"></i>
                </div>
                <h4>İletişim Bilgisini Sil</h4>
                <p class="mb-0">Aşağıdaki kaydı silmek üzeresiniz:</p>
                <span class="delete-name" id="deleteName"></span>
                <p class="delete-warning">
                    <i class="la la-exclamation-triangle"></i>
                    Bu işlem geri alınamaz. Footer'daki bilgiler boş kalabilir.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="la la-close"></i> Vazgeç
                </button>
                <a href="#" id="deleteConfirm" class="btn btn-danger">
                    <i class="la la-trash"></i> Evet, Sil
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteModal(button) {
        document.getElementById("deleteName").innerText = button.getAttribute("data-name");
        document.getElementById("deleteConfirm").setAttribute("href", button.getAttribute("data-url"));
    }
</script>