@model CreateSliderDto

@{
    ViewData["Title"] = "Yeni Slayt";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Yeni Slayt</h4>

        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Slayt Bilgileri</div>
                        <div class="card-category">Ana sayfaya yeni bir slayt ekleyin</div>
                    </div>
                    <form method="post">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="form-group">
                                <label asp-for="Title">Başlık</label>
                                <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Ateşte pişer, sıcak gelir." required />
                                <small class="form-text text-muted">Birinci kelime üst satıra, ikinci kelime vurgulu orta satıra, kalanı alt satıra yazılır.</small>
                                <span asp-validation-for="Title" class="text-danger small"></span>

                            </div>
                            <div class="form-group">
                                <label asp-for="Description">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Başlığın altında görünecek kısa açıklama" required></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>

                            </div>
                        </div>
                        <div class="card-action">
                            <button type="submit" class="btn btn-success">
                                <i class="la la-check"></i> Kaydet
                            </button>
                            <a href="/Admin/Slider/Index" class="btn btn-danger">
                                <i class="la la-close"></i> Vazgeç
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>