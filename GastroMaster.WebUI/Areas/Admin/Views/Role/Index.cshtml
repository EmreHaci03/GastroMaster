@model List<ResultRoleDto>

@{
    ViewData["Title"] = "Roller";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    .role-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(21, 114, 232, .12);
        color: #1572e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

        .role-icon.admin {
            background: rgba(243, 84, 93, .12);
            color: #f3545d;
        }

    .delete-modal .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0, 0, 0, .2);
    }

    .delete-modal .modal-body {
        padding: 35px 30px 25px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(243, 84, 93, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: deletePulse 1.6s infinite;
    }

        .delete-modal .delete-icon i {
            font-size: 40px;
            color: #f3545d;
        }

    .delete-modal .delete-name {
        display: inline-block;
        margin: 6px 0 14px;
        padding: 4px 14px;
        border-radius: 20px;
        background: #f4f5f8;
        font-weight: 600;
        color: #333;
    }

    .delete-modal .delete-warning {
        font-size: 13px;
        color: #8d9498;
        margin-bottom: 0;
    }

    .delete-modal .modal-footer {
        border-top: none;
        justify-content: center;
        padding: 0 30px 30px;
    }

        .delete-modal .modal-footer .btn {
            min-width: 130px;
            border-radius: 25px;
            font-weight: 500;
        }

    @@keyframes deletePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, .35);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(243, 84, 93, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, 0);
        }
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Roller</h4>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <div class="card-title">Rol Listesi</div>
                            <div class="card-category">Sistemdeki rolleri buradan yönetebilirsiniz</div>
                        </div>
                        <div>
                            <a href="/Admin/Role/UserList" class="btn btn-default">
                                <i class="la la-users"></i> Kullanıcılar ve Rol Atama
                            </a>
                            <a href="/Admin/Role/CreateRole" class="btn btn-primary">
                                <i class="la la-plus"></i> Yeni Rol
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mt-3">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col"></th>
                                        <th scope="col">Rol Adı</th>
                                        <th scope="col" class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            count++;
                                            <tr>
                                                <td>@count</td>
                                                <td>
                                                    <div class="role-icon @(item.RoleName == "Admin" ? "admin" : "")">
                                                        <i class="la @(item.RoleName == "Admin" ? "la-shield" : "la-user")"></i>
                                                    </div>
                                                </td>
                                                <td><strong>@item.RoleName</strong></td>
                                                <td class="text-center" style="white-space:nowrap;">
                                                    @if (item.RoleName == "Admin")
                                                    {
                                                        <span class="badge badge-default"><i class="la la-lock"></i> Sistem rolü</span>
                                                    }
                                                    else
                                                    {
                                                        <a href="/Admin/Role/UpdateRole/@item.RoleId" class="btn btn-warning btn-sm">
                                                            <i class="la la-edit"></i> Güncelle
                                                        </a>
                                                        <button type="button" class="btn btn-danger btn-sm"
                                                                data-toggle="modal" data-target="#deleteModal"
                                                                data-name="@item.RoleName"
                                                                data-url="/Admin/Role/DeleteRole/@item.RoleId"
                                                                onclick="setDeleteModal(this)">
                                                            <i class="la la-trash"></i> Sil
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="la la-inbox" style="font-size:32px;"></i>
                                                <p class="mb-0">Henüz rol eklenmemiş.</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon">
                    <i class="la la-trash"></i>
                </div>
                <h4 style="font-weight:600;">Rolü Sil</h4>
                <p class="mb-0">Aşağıdaki rolü silmek üzeresiniz:</p>
                <span class="delete-name" id="deleteName"></span>
                <p class="delete-warning">
                    <i class="la la-exclamation-triangle"></i>
                    Bu roldeki kullanıcıların rolü de kaldırılır.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="la la-close"></i> Vazgeç
                </button>
                <form method="post" id="deleteForm" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="la la-trash"></i> Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteModal(button) {
        document.getElementById("deleteName").innerText = button.getAttribute("data-name");
        document.getElementById("deleteForm").setAttribute("action", button.getAttribute("data-url"));
    }
</script>