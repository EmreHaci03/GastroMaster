@model List<UserWithRolesDto>

@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 190, 51, .15);
        color: #c48a00;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        text-transform: uppercase;
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Kullanıcılar</h4>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <div class="card-title">Kullanıcı Listesi</div>
                            <div class="card-category">Kullanıcılara buradan rol atayabilirsiniz</div>
                            <div>
                                <a href="/Admin/Role/ExportToExcel/" class="btn btn-success">
                                    <i class="la la-file-excel-o"></i> Excel'e Aktar
                                </a>
                            </div>
                        </div>
                        <a href="/Admin/Role/Index" class="btn btn-default">
                            <i class="la la-shield"></i> Roller
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mt-3">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col"></th>
                                        <th scope="col">Ad Soyad</th>
                                        <th scope="col">Kullanıcı Adı</th>
                                        <th scope="col">E-posta</th>
                                        <th scope="col">Roller</th>
                                        <th scope="col" class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            count++;
                                            <tr>
                                                <td>@count</td>
                                                <td><div class="user-avatar">@(string.IsNullOrEmpty(item.UserName) ? "?" : item.UserName.Substring(0, 1))</div></td>
                                                <td><strong>@item.NameSurname</strong></td>
                                                <td class="text-muted">@item.UserName</td>
                                                <td class="text-muted">@item.Email</td>
                                                <td>
                                                    @if (item.Roles.Any())
                                                    {
                                                        @foreach (var role in item.Roles)
                                                        {
                                                            <span class="badge @(role == "Admin" ? "badge-danger" : "badge-info")">@role</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Rol yok</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <a href="/Admin/Role/AssignRole?userId=@item.UserId" class="btn btn-primary btn-sm">
                                                        <i class="la la-user-plus"></i> Rol Ata
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">
                                                <i class="la la-inbox" style="font-size:32px;"></i>
                                                <p class="mb-0">Henüz kullanıcı yok.</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>