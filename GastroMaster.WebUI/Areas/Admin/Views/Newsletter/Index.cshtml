@model List<ResultNewsletterDto>

@{
    ViewData["Title"] = "Bülten Aboneleri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .mail-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 190, 51, .15);
        color: #c48a00;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        text-transform: uppercase;
    }

    .mail-domain {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        background: #f4f5f8;
        color: #555;
        font-size: 12px;
        font-weight: 600;
    }

    .mail-search {
        max-width: 320px;
        margin-bottom: 10px;
    }

    .delete-modal .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0, 0, 0, .2);
    }

    .delete-modal .modal-body {
        padding: 35px 30px 25px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(243, 84, 93, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: deletePulse 1.6s infinite;
    }

        .delete-modal .delete-icon i {
            font-size: 40px;
            color: #f3545d;
        }

    .delete-modal h4 {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .delete-modal .delete-name {
        display: inline-block;
        margin: 6px 0 14px;
        padding: 4px 14px;
        border-radius: 20px;
        background: #f4f5f8;
        font-weight: 600;
        color: #333;
    }

    .delete-modal .delete-warning {
        font-size: 13px;
        color: #8d9498;
        margin-bottom: 0;
    }

    .delete-modal .modal-footer {
        border-top: none;
        justify-content: center;
        padding: 0 30px 30px;
    }

        .delete-modal .modal-footer .btn {
            min-width: 130px;
            border-radius: 25px;
            font-weight: 500;
        }

    @@keyframes deletePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, .35);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(243, 84, 93, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, 0);
        }
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Bülten Aboneleri</h4>

        <div class="row">
            <div class="col-md-3">
                <div class="card card-stats card-primary">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-users"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Toplam Abone</p>
                                    <h4 class="card-title">@Model.Count</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-danger">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-google"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Gmail</p>
                                    <h4 class="card-title">@Model.Count(x => x.Email.EndsWith("@gmail.com"))</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-success">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-windows"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Hotmail / Outlook</p>
                                    <h4 class="card-title">@Model.Count(x => x.Email.EndsWith("@hotmail.com") || x.Email.EndsWith("@outlook.com"))</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-warning">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-envelope"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Diğer</p>
                                    <h4 class="card-title">@Model.Count(x => !x.Email.EndsWith("@gmail.com") && !x.Email.EndsWith("@hotmail.com") && !x.Email.EndsWith("@outlook.com"))</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Abone Listesi</div>
                        <div class="card-category">Bültene abone olan tüm mail adreslerini buradan yönetebilirsiniz</div>
                    </div>
                    <div class="card-body">
                        @if (Model.Any())
                        {
                            <input type="text" id="mailSearch" class="form-control mail-search" placeholder="Mail adresinde ara..." />
                        }
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mt-3">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col"></th>
                                        <th scope="col">E-posta</th>
                                        <th scope="col">Sağlayıcı</th>
                                        <th scope="col" class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any())
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr data-mail="@item.Email.ToLower()">
                                                <td>@item.NewsletterId</td>
                                                <td><div class="mail-avatar">@item.Email.Substring(0, 1)</div></td>
                                                <td><strong>@item.Email</strong></td>
                                                <td><span class="mail-domain">@item.Email.Substring(item.Email.IndexOf("@@") + 1)</span></td>
                                                <td class="text-center" style="white-space:nowrap;">
                                                    <a href="mailto:@item.Email" class="btn btn-info btn-sm" title="Mail Gönder">
                                                        <i class="la la-paper-plane"></i> Mail Gönder
                                                    </a>
                                                    <button type="button" class="btn btn-danger btn-sm" title="Sil"
                                                            data-toggle="modal" data-target="#deleteModal"
                                                            data-name="@item.Email"
                                                            data-url="/Admin/Newsletter/DeleteNewsletter/@item.NewsletterId"
                                                            onclick="setDeleteModal(this)">
                                                        <i class="la la-trash"></i> Sil
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">
                                                <i class="la la-inbox" style="font-size:32px;"></i>
                                                <p class="mb-0">Henüz abone yok.</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon">
                    <i class="la la-trash"></i>
                </div>
                <h4>Aboneyi Sil</h4>
                <p class="mb-0">Aşağıdaki aboneyi silmek üzeresiniz:</p>
                <span class="delete-name" id="deleteName"></span>
                <p class="delete-warning">
                    <i class="la la-exclamation-triangle"></i>
                    Bu işlem geri alınamaz. Mail adresi bülten listesinden kaldırılır.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="la la-close"></i> Vazgeç
                </button>
                <a href="#" id="deleteConfirm" class="btn btn-danger">
                    <i class="la la-trash"></i> Evet, Sil
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteModal(button) {
        document.getElementById("deleteName").innerText = button.getAttribute("data-name");
        document.getElementById("deleteConfirm").setAttribute("href", button.getAttribute("data-url"));
    }

    var mailSearch = document.getElementById("mailSearch");
    if (mailSearch) {
        mailSearch.addEventListener("input", function () {
            var text = mailSearch.value.toLowerCase();
            document.querySelectorAll("tbody tr[data-mail]").forEach(function (row) {
                row.style.display = row.getAttribute("data-mail").includes(text) ? "" : "none";
            });
        });
    }
</script>