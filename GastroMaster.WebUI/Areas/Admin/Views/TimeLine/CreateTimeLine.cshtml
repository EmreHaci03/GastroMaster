@model CreateTimeLineDto

@{
    ViewData["Title"] = "Yeni Kayıt";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Yeni Kayıt</h4>

        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Kayıt Bilgileri</div>
                        <div class="card-category">Hakkımızda sayfasındaki yol haritasına yeni bir adım ekleyin</div>
                    </div>
                    <form method="post">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="form-group">
                                <label asp-for="Year">Yıl</label>
                                <input type="number" asp-for="Year" class="form-control" placeholder="Örn: 2026" />
                                <span asp-validation-for="Year" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Title">Başlık</label>
                                <input type="text" asp-for="Title" class="form-control" placeholder="Örn: İkinci şube" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Description">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Bu yıl neler oldu?"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="card-action">
                            <button type="submit" class="btn btn-success">
                                <i class="la la-check"></i> Kaydet
                            </button>
                            <a href="/Admin/TimeLine/Index" class="btn btn-danger">
                                <i class="la la-close"></i> Vazgeç
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>