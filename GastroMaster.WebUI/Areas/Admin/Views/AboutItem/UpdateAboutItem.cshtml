@model UpdateAboutItemDto

@{
    ViewData["Title"] = "Madde Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Madde Güncelle</h4>

        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Madde Bilgileri</div>
                        <div class="card-category">"@Model.Title" maddesini düzenliyorsunuz</div>
                    </div>
                    <form method="post">
                        <input type="hidden" asp-for="AboutItemId" />
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="Title">Başlık</label>
                                <input type="text" asp-for="Title" class="form-control" required />
                            </div>
                            <div class="form-group">
                                <label asp-for="Description">Açıklama</label>
                                <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                            </div>
                        </div>
                        <div class="card-action">
                            <button type="submit" class="btn btn-success">
                                <i class="la la-check"></i> Güncelle
                            </button>
                            <a href="/Admin/AboutItem/Index" class="btn btn-danger">
                                <i class="la la-close"></i> Vazgeç
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>