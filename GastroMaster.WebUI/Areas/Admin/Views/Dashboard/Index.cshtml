                        <div class="table-tile empty"><i class="la la-check-circle"></i>Masa 3<small>Boş</small></div>
                        <div class="table-tile empty"><i class="la la-check-circle"></i>Masa 4<small>Boş</small></div>
                        <div class="table-tile full"><i class="la la-users"></i>Masa 5<small>₺735,00</small></div>
