                    </div>
                    <div class="bar-chart">
                        <div class="bar-item"><div class="bar" id="bar1"><span id="bar1Value">0</span></div><div class="bar-label" id="bar1Label">-</div></div>
                        <div class="bar-item"><div class="bar" id="bar2"><span id="bar2Value">0</span></div><div class="bar-label" id="bar2Label">-</div></div>
                        <div class="bar-item"><div class="bar" id="bar3"><span id="bar3Value">0</span></div><div class="bar-label" id="bar3Label">-</div></div>
                        <div class="bar-item"><div class="bar" id="bar4"><span id="bar4Value">0</span></div><div class="bar-label" id="bar4Label">-</div></div>
                        <div class="bar-item"><div class="bar" id="bar5"><span id="bar5Value">0</span></div><div class="bar-label" id="bar5Label">-</div></div>
                        <div class="bar-item"><div class="bar" id="bar6"><span id="bar6Value">0</span></div><div class="bar-label" id="bar6Label">-</div></div>
                        <div class="bar-item"><div class="bar today" id="bar7"><span id="bar7Value">0</span></div><div class="bar-label" id="bar7Label"><strong>Bugün</strong></div></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="panel">
                    <div class="panel-header">
                        <h5 class="panel-title">Masa Durumu</h5>
                        <a href="#" class="panel-link">Tümü</a>
                    </div>
                    <div class="table-grid">
                        <div class="table-tile empty"><i class="la la-check-circle"></i>Masa 1<small>Boş</small></div>
