@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .welcome-card {
        border-radius: 16px;
        padding: 28px 30px;
        color: #fff;
        background: linear-gradient(135deg, #222831, #3c4452);
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
    }

        .welcome-card h3 {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .welcome-card p {
            opacity: .8;
            margin-bottom: 0;
        }

        .welcome-card .welcome-icon {
            position: absolute;
            right: 30px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 90px;
            color: #ffbe33;
            opacity: .35;
        }

    .stat-box {
        border-radius: 14px;
        padding: 22px;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 25px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, .08);
    }

        .stat-box .stat-icon {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 58px;
            opacity: .25;
        }

        .stat-box .stat-label {
            font-size: 13px;
            opacity: .9;
            margin-bottom: 6px;
        }

        .stat-box .stat-value {
            font-size: 30px;
            font-weight: 700;
            line-height: 1;
        }

        .stat-box .stat-sub {
            font-size: 12px;
            opacity: .85;
            margin-top: 8px;
        }

    .bg-blue {
        background: linear-gradient(135deg, #1572e8, #4a9bff);
    }

    .bg-green {
        background: linear-gradient(135deg, #2bb930, #5ad85e);
    }

    .bg-orange {
        background: linear-gradient(135deg, #f39c12, #ffbe33);
    }

    .bg-purple {
        background: linear-gradient(135deg, #6f42c1, #9b6dff);
    }

    .panel {
        border-radius: 14px;
        background: #fff;
        padding: 22px;
        margin-bottom: 25px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, .05);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .panel-title {
        font-size: 16px;
        font-weight: 600;
        margin: 0;
    }

    .panel-link {
        font-size: 13px;
        color: #1572e8;
    }

    .bar-chart {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        height: 200px;
        padding-top: 10px;
    }

    .bar-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
    }

    .bar {
        width: 100%;
        max-width: 42px;
        border-radius: 8px 8px 0 0;
        background: linear-gradient(180deg, #ffbe33, #f39c12);
        position: relative;
    }

        .bar.today {
            background: linear-gradient(180deg, #4a9bff, #1572e8);
        }

        .bar span {
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 11px;
            font-weight: 600;
            color: #555;
            white-space: nowrap;
        }

    .bar-label {
        margin-top: 8px;
        font-size: 12px;
        color: #8d9498;
    }

    .table-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .table-tile {
        border-radius: 12px;
        padding: 16px 10px;
        text-align: center;
        font-weight: 600;
        border: 2px solid transparent;
    }

        .table-tile i {
            display: block;
            font-size: 26px;
            margin-bottom: 6px;
        }

        .table-tile small {
            display: block;
            font-weight: 400;
            font-size: 11px;
            margin-top: 2px;
        }

        .table-tile.full {
            background: rgba(243, 84, 93, .1);
            border-color: rgba(243, 84, 93, .3);
            color: #e63946;
        }

        .table-tile.empty {
            background: rgba(49, 206, 54, .1);
            border-color: rgba(49, 206, 54, .3);
            color: #2bb930;
        }

    .top-product {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 0;
        border-bottom: 1px solid #f1f2f3;
    }

        .top-product:last-child {
            border-bottom: none;
        }

        .top-product .rank {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #f4f5f8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 13px;
        }

            .top-product .rank.gold {
                background: #ffbe33;
                color: #fff;
            }

            .top-product .rank.silver {
                background: #b0b4b8;
                color: #fff;
            }

            .top-product .rank.bronze {
                background: #cd7f32;
                color: #fff;
            }

        .top-product .info {
            flex: 1;
        }

            .top-product .info strong {
                display: block;
                font-size: 14px;
            }

            .top-product .info small {
                color: #8d9498;
            }

        .top-product .sold {
            font-weight: 700;
            color: #222831;
        }

    .order-status {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

        .order-status.open {
            background: rgba(255, 173, 70, .15);
            color: #e08a00;
        }

        .order-status.closed {
            background: rgba(49, 206, 54, .15);
            color: #2bb930;
        }
</style>

<div class="content">
