</div>


<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
<script>
    var connection = new signalR.HubConnectionBuilder()
        .withUrl("https://localhost:7139/SignalRHub")
        .withAutomaticReconnect()
        .build();

    var intervalId = null;

    function setValue(id, value) {
        var element = document.getElementById(id);
        if (!element) return;
        element.innerText = value;
    }

    function formatPrice(value) {
        return Number(value).toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    connection.on("ReceiveTodayOrderAmount", function (data) {
        if (data === null || data === undefined) return;
        setValue("todayRevenue", formatPrice(data));
    });

    connection.on("ReceiveCashRegisterAmount", function (data) {
        if (data === null || data === undefined) return;
        setValue("TotalCashRegisterAmount", formatPrice(data));
    });

    connection.on("ReceiveClosedOrderCount", function (data) {
        if (data === null || data === undefined) return;
        setValue("GetClosedOrderCount", data);
    });
    var activeTableCount = 0;
    var occupiedTableCount = 0; 

    function updateAvailableTables() {
        setValue("AvailableTableCount", Math.max(activeTableCount - occupiedTableCount, 0));
    }
    connection.on("ReceiveActiveTableCount", function (data) {
        if (data === null || data === undefined) return;
        activeTableCount = data;
        setValue("ActiveTableCount", data);
        updateAvailableTables();
    });

    connection.on("ReceiveOccupiedMenuTableCount", function (data) {
        if (data === null || data === undefined) return;
        occupiedTableCount = data;
        setValue("OccupiedMenuTableCount", data);
        updateAvailableTables();
    });

    connection.on("ReceiveTopSellingProducts", function (data) {
        for (var i = 0; i < 5; i++) {
            var item = data[i];
            setValue("product" + (i + 1) + "Name", item ? item.productName : "-");
            setValue("product" + (i + 1) + "Category", item ? item.categoryName : "-");
            setValue("product" + (i + 1) + "Sold", item ? item.soldCount : 0);
        }
    });

    connection.on("ReceiveTodayReservationCount", function (data) {
        document.getElementById("TodayReservationCount").innerText = data;
    });
    connection.on("ReceiveTotalReservationCount", function (data) {
        document.getElementById("TotalReservationCount").innerText = data;
    });



    connection.on("ReceiveLastWeekRevenue", function (data) {
        var days = ["Paz", "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt"];
        var max = Math.max.apply(null, data.map(function (x) { return x.revenue; })) || 1;

        for (var i = 0; i < 7; i++) {
            var item = data[i];
            var n = i + 1;
            if (!item) continue;

            setValue("bar" + n + "Value", formatPrice(item.revenue));
            document.getElementById("bar" + n).style.height = Math.max(item.revenue / max * 90, 3) + "%";

            if (n < 7) {
                setValue("bar" + n + "Label", days[new Date(item.date).getDay()]);
            }
        }
    });
    

    connection.on("ReceiveLastOrders", function (data) {
        for (var i = 0; i < 5; i++) {
            var item = data[i];
            var n = i + 1;
            setValue("order" + n + "Id", item ? item.orderDetailId : "-");
            setValue("order" + n + "Product", item ? item.productName : "-");
            setValue("order" + n + "Table", item ? item.menuTableName : "-");
            setValue("order" + n + "Date", item ? new Date(item.date).toLocaleString("tr-TR") : "-");
            setValue("order" + n + "Total", item ? "₺" + formatPrice(item.totalPrice) : "-");
            setValue("order" + n + "Status", item ? item.description : "-");

            var status = document.getElementById("order" + n + "Status");
            status.className = "order-status " + (item && item.description === "Hesap Kapatıldı" ? "closed" : "open");
        }
    });



    connection.onreconnected(function () {
        connection.invoke("DashboardStatistic");
    });

    connection.onclose(function () {
        if (intervalId) { clearInterval(intervalId); }
    });

    connection.start()
        .then(function () {
            connection.invoke("DashboardStatistic");
            intervalId = setInterval(function () {
                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("DashboardStatistic");
                }
            }, 3000);
        })
        .catch(function (err) {
            console.error(err.toString());
        });
</script>