@model List<ResultProductWithCategoryDto>

@{
    ViewData["Title"] = "Ürünler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count=0;
}

<style>
    .product-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #eee;
        background: #f4f5f8;
    }

    .product-price {
        font-weight: 700;
        color: #222831;
        white-space: nowrap;
    }

    .category-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        background: rgba(255, 190, 51, .15);
        color: #c48a00;
        font-size: 12px;
        font-weight: 600;
    }

    .category-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

        .category-filter button {
            border: 1px solid #e3e6ea;
            background: #fff;
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 13px;
            cursor: pointer;
            transition: all .2s;
        }

            .category-filter button:hover,
            .category-filter button.active {
                background: #222831;
                border-color: #222831;
                color: #ffbe33;
            }

    .delete-modal .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0, 0, 0, .2);
    }

    .delete-modal .modal-body {
        padding: 35px 30px 25px;
        text-align: center;
    }

    .delete-modal .delete-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: rgba(243, 84, 93, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: deletePulse 1.6s infinite;
    }

        .delete-modal .delete-icon i {
            font-size: 40px;
            color: #f3545d;
        }

    .delete-modal h4 {
        font-weight: 600;
        margin-bottom: 10px;
    }

    .delete-modal .delete-name {
        display: inline-block;
        margin: 6px 0 14px;
        padding: 4px 14px;
        border-radius: 20px;
        background: #f4f5f8;
        font-weight: 600;
        color: #333;
    }

    .delete-modal .delete-warning {
        font-size: 13px;
        color: #8d9498;
        margin-bottom: 0;
    }

    .delete-modal .modal-footer {
        border-top: none;
        justify-content: center;
        padding: 0 30px 30px;
    }

        .delete-modal .modal-footer .btn {
            min-width: 130px;
            border-radius: 25px;
            font-weight: 500;
        }

    @@keyframes deletePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, .35);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(243, 84, 93, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(243, 84, 93, 0);
        }
    }
</style>

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Ürünler</h4>

        <div class="row">
            <div class="col-md-3">
                <div class="card card-stats card-primary">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-cutlery"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Toplam Ürün</p>
                                    <h4 class="card-title">@Model.Count</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-success">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-check-circle"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Aktif</p>
                                    <h4 class="card-title">@Model.Count(x => x.ProductStatus)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-danger">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-times-circle"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Pasif</p>
                                    <h4 class="card-title">@Model.Count(x => !x.ProductStatus)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card card-stats card-warning">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-5">
                                <div class="icon-big text-center">
                                    <i class="la la-money"></i>
                                </div>
                            </div>
                            <div class="col-7 d-flex align-items-center">
                                <div class="numbers">
                                    <p class="card-category">Ort. Fiyat</p>
                                    <h4 class="card-title">₺@(Model.Any() ? Model.Average(x => x.Price).ToString("N0") : "0")</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <div class="card-title">Ürün Listesi</div>
                            <div class="card-category">Menüdeki tüm ürünleri buradan yönetebilirsiniz</div>
                        </div>
                        <div>
                            <a href="/Admin/Product/ExportToExcel" class="btn btn-success">
                                <i class="la la-file-excel-o"></i> Excel'e Aktar
                            </a>
                            <a href="/Admin/Product/ExportToPdf" class="btn btn-danger">
                                <i class="la la-file-pdf-o"></i> PDF'e Aktar
                            </a>
                            <a href="/Admin/Product/CreateProduct" class="btn btn-primary">
                                <i class="la la-plus"></i> Yeni Ürün
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.Any())
                        {
                            <div class="category-filter">
                                <button type="button" class="active" data-filter="all">Tümü (@Model.Count)</button>
                                @foreach (var group in Model.GroupBy(x => x.Category).OrderBy(x => x.Key))
                                {
                                    <button type="button" data-filter="@group.Key">@group.Key (@group.Count())</button>
                                }
                            </div>
                        }
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mt-3">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Görsel</th>
                                        <th scope="col">Ürün</th>
                                        <th scope="col">Kategori</th>
                                        <th scope="col">Fiyat</th>
                                        <th scope="col">Durum</th>
                                        <th scope="col" class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Any())
                                    {
                                        @foreach (var item in Model)
                                            {
                                                count++;
                                                <tr data-category="@item.Category">
                            
                                                                            <td>@count</td>
                            
                                                                            <td><img src="@item.ImageUrl" class="product-img" alt="@item.ProductName" /></td>
                                                <td style="min-width:200px;">
                                                    <strong>@item.ProductName</strong>
                                                    <div class="small text-muted">
                                                        @(item.Description?.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                                                    </div>
                                                </td>
                                                <td><span class="category-badge">@item.Category</span></td>
                                                <td class="product-price">₺@item.Price.ToString("N2")</td>
                                                <td>
                                                    @if (item.ProductStatus)
                                        {
                                                        <span class="badge badge-success"><i class="la la-check"></i> Aktif</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger"><i class="la la-close"></i> Pasif</span>
                                                    }
                                                </td>
                                                <td class="text-center" style="white-space:nowrap;">
                                                    <a href="/Admin/Product/UpdateProduct/@item.ProductId" class="btn btn-warning btn-sm" title="Güncelle">
                                                        <i class="la la-edit"></i> Güncelle
                                                    </a>
                                                    <button type="button" class="btn btn-danger btn-sm" title="Sil"
                                                            data-toggle="modal" data-target="#deleteModal"
                                                            data-name="@item.ProductName"
                                                            data-url="/Admin/Product/DeleteProduct/@item.ProductId"
                                                            onclick="setDeleteModal(this)">
                                                        <i class="la la-trash"></i> Sil
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">
                                                <i class="la la-inbox" style="font-size:32px;"></i>
                                                <p class="mb-0">Henüz ürün eklenmemiş.</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade delete-modal" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="delete-icon">
                    <i class="la la-trash"></i>
                </div>
                <h4>Ürünü Sil</h4>
                <p class="mb-0">Aşağıdaki ürünü silmek üzeresiniz:</p>
                <span class="delete-name" id="deleteName"></span>
                <p class="delete-warning">
                    <i class="la la-exclamation-triangle"></i>
                    Bu işlem geri alınamaz. Ürün menüden kaldırılır.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">
                    <i class="la la-close"></i> Vazgeç
                </button>
                <a href="#" id="deleteConfirm" class="btn btn-danger">
                    <i class="la la-trash"></i> Evet, Sil
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function setDeleteModal(button) {
        document.getElementById("deleteName").innerText = button.getAttribute("data-name");
        document.getElementById("deleteConfirm").setAttribute("href", button.getAttribute("data-url"));
    }

    var filterButtons = document.querySelectorAll(".category-filter button");
    filterButtons.forEach(function (button) {
        button.addEventListener("click", function () {
            var filter = button.getAttribute("data-filter");
            filterButtons.forEach(function (b) { b.classList.remove("active"); });
            button.classList.add("active");
            document.querySelectorAll("tbody tr[data-category]").forEach(function (row) {
                row.style.display = (filter === "all" || row.getAttribute("data-category") === filter) ? "" : "none";
            });
        });
    });
</script>